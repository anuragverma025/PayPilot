# PayPilot Backend Environment Variables
NODE_ENV=development
PORT=5000
CLIENT_URL=http://localhost:5173

# Database configuration (MongoDB Atlas or Local MongoDB)
# Note: If MongoDB is unavailable, PayPilot automatically runs in zero-config in-memory mode!
MONGODB_URI=mongodb://127.0.0.1:27017/paypilot

# AI Provider Configuration (Google Gemini)
# PayPilot uses Google Gemini (@google/genai) for natural language reasoning.
# If AI_API_KEY is omitted, PayPilot transparently uses its deterministic rule engine fallback!
AI_PROVIDER=gemini
AI_API_KEY=your_gemini_api_key_here
AI_MODEL=gemini-3-flash-preview

# PayPal Developer Sandbox Credentials
# Get sandbox credentials from: https://developer.paypal.com/dashboard/applications/sandbox
# If left empty, PayPilot automatically enables simulated sandbox mode for immediate testing!
PAYPAL_CLIENT_ID=your_paypal_sandbox_client_id
PAYPAL_CLIENT_SECRET=your_paypal_sandbox_secret
PAYPAL_BASE_URL=https://api-m.sandbox.paypal.com
PAYPAL_MODE=sandbox
PAYPAL_CURRENCY=USD
