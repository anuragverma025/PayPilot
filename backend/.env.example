# PayPilot Backend Environment Variables
NODE_ENV=development
PORT=5000
CLIENT_URL=http://localhost:5173

# Database configuration (MongoDB Atlas or Local MongoDB)
MONGODB_URI=mongodb://127.0.0.1:27017/paypilot

# AI Provider Configuration (Phase 2 - replace or configure when ready)
# Supported providers: 'anthropic' | 'openai' | 'gemini' | 'mock'
AI_PROVIDER=mock
AI_API_KEY=your_api_key_here

# PayPal Developer Sandbox Credentials (Phase 3)
PAYPAL_CLIENT_ID=your_paypal_sandbox_client_id
PAYPAL_CLIENT_SECRET=your_paypal_sandbox_secret
PAYPAL_BASE_URL=https://api-m.sandbox.paypal.com
PAYPAL_MODE=sandbox
PAYPAL_CURRENCY=USD
